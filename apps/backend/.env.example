# ------------------------------
# Backend application settings
# ------------------------------
SERVICE_NAME=3pull-api
API_PORT=8000
API_LOG_LEVEL=INFO

# Optional: database connection string
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/your_db
DATABASE_URL=

# ------------------------------
# Gunicorn settings (used by Makefile `make up`)
# ------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
