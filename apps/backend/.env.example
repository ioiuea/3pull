# ------------------------------
# Backend application settings
# ------------------------------

# SERVICE_NAME
# このAPIの識別名です。FastAPIの title やログ出力に使われます。
# 推奨: 環境を識別しやすい名前（例: 3pull-api, 3pull-api-dev）。
SERVICE_NAME=3pull-api

# API_PORT
# APIプロセスが待ち受けるポート番号です。
# ローカルの一般例: 8000 / 8080。重複する場合は空きポートに変更します。
API_PORT=8000

# API_LOG_LEVEL
# ログの出力レベルです（DEBUG/INFO/WARNING/ERROR）。
# 推奨: 開発=INFO or DEBUG、本番=INFO。
API_LOG_LEVEL=INFO

# ------------------------------
# Database (required)
# ------------------------------

# DATABASE_URL
# SQLAlchemy 非同期 URL（psycopg v3）です。
# 形式: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>?<option>
# 必須値。未設定だとアプリ起動時に失敗します。
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/threepull

# DATABASE_ECHO
# true にすると発行SQLをログ出力します（デバッグ用）。
# 推奨: 開発でSQL調査時のみ true / 通常運用と本番は false。
DATABASE_ECHO=false

# DATABASE_POOL_SIZE
# 1プロセスあたりの常駐コネクション数です。
# 実接続上限の目安: workers × (POOL_SIZE + MAX_OVERFLOW)
# 例: workers=2, pool=5, overflow=10 -> 最大 30 接続
# 一般的な初期値: 5〜10。DB上限接続数から逆算して決めます。
DATABASE_POOL_SIZE=5

# DATABASE_MAX_OVERFLOW
# 常駐分を超えたときに一時的に追加で確保できる接続数です。
# 一般的な初期値: 5〜20。短時間の突発アクセス吸収に使います。
# DB接続上限が厳しい場合は小さく設定します。
DATABASE_MAX_OVERFLOW=10

# DATABASE_POOL_TIMEOUT
# プールに空き接続がない場合の待機時間（秒）です。
# 一般的な初期値: 30。タイムアウト多発時はアプリ負荷かDB接続設計を見直します。
DATABASE_POOL_TIMEOUT=30

# ------------------------------
# Email verification / password reset
# ------------------------------

# EMAIL_VERIFICATION_TTL_MINUTES
# メール検証トークンの有効期限（分）です。
# 一般的な範囲: 30〜1440（30分〜24時間）。
# 推奨: 60（セキュリティとユーザー体験のバランス）。
EMAIL_VERIFICATION_TTL_MINUTES=60

# PASSWORD_RESET_TTL_MINUTES
# パスワードリセットトークンの有効期限（分）です。
# 一般的な範囲: 15〜120。
# 推奨: 30〜60。短すぎると失敗増、長すぎると漏えいリスク増。
PASSWORD_RESET_TTL_MINUTES=60

# ------------------------------
# Email login policy
# ------------------------------

# EMAIL_LOGIN_MAX_FAILURES
# 連続ログイン失敗でロックする閾値です。
# 一般的な範囲: 5〜10。
# 推奨: 5（セキュリティ重視）。
EMAIL_LOGIN_MAX_FAILURES=5

# EMAIL_LOGIN_LOCK_MINUTES
# ロック継続時間（分）です。
# 一般的な範囲: 10〜30。
# 推奨: 15。
EMAIL_LOGIN_LOCK_MINUTES=15

# ------------------------------
# Argon2id password hashing
# ------------------------------

# ARGON2_TIME_COST
# 計算反復回数。大きいほど安全ですがログイン処理は遅くなります。
# 一般的な範囲: 2〜4。推奨初期値: 3。
# 運用目安: 1回ハッシュがサーバで概ね 100〜300ms 程度になるよう調整。
ARGON2_TIME_COST=3

# ARGON2_MEMORY_COST
# 使用メモリ量（KiB）。GPU耐性に効く主要パラメータです。
# 65536 KiB = 64 MiB。
# 一般的な範囲: 32768〜131072（32〜128 MiB）。推奨初期値: 65536。
# 同時ログイン数が多い場合は、time_cost とのバランスで調整します。
ARGON2_MEMORY_COST=65536

# ARGON2_PARALLELISM
# 並列レーン数（CPU利用度）。
# 一般的な範囲: 1〜4。推奨初期値: 2〜4。
# 目安: min(利用可能vCPU, 4)。
ARGON2_PARALLELISM=4

# ARGON2_HASH_LEN
# 生成ハッシュ長（バイト）。
# 一般的な値: 16 / 32。推奨: 32。
ARGON2_HASH_LEN=32

# ARGON2_SALT_LEN
# ソルト長（バイト）。
# 一般的な値: 16 以上。推奨: 16。
ARGON2_SALT_LEN=16

# ------------------------------
# App session (DB sessions + HttpOnly Cookie)
# ------------------------------

# SESSION_TTL_SECONDS
# セッション有効期限（秒）です。604800秒=7日。
# 許容範囲: 3600〜2592000（1時間〜30日）。
# 推奨: 604800（7日）。
SESSION_TTL_SECONDS=604800

# SESSION_EXPIRED_GRACE_DAYS
# 期限切れセッションを削除するまでの猶予日数です。
# 許容範囲: 0〜7。推奨: 3。
SESSION_EXPIRED_GRACE_DAYS=3

# AUTH_AUDIT_RETENTION_DAYS
# 監査ログ保持期間（日）です。
# 許容範囲: 1〜2555（約7年）。推奨: 365（1年）。
AUTH_AUDIT_RETENTION_DAYS=365

# SESSION_CLEANUP_ENABLED
# true: セッションcleanupジョブを有効化 / false: 無効化。
SESSION_CLEANUP_ENABLED=true

# AUDIT_CLEANUP_ENABLED
# true: 監査ログretention cleanupジョブを有効化 / false: 無効化。
AUDIT_CLEANUP_ENABLED=true

# CLEANUP_BATCH_SIZE
# cleanupで1回に削除する上限件数です。
# 許容範囲: 100〜50000。推奨: 5000。
CLEANUP_BATCH_SIZE=5000

# SESSION_COOKIE_NAME
# ブラウザに保存するセッションCookie名です。
# 他システムと重複しにくい名前を推奨します。
SESSION_COOKIE_NAME=app_session

# SESSION_COOKIE_SECURE
# true: HTTPSでのみCookie送信 / false: HTTPでも送信。
# 推奨: 本番は必ず true。ローカルHTTP開発のみ false。
SESSION_COOKIE_SECURE=true

# SESSION_COOKIE_SAMESITE
# CSRF軽減のSameSite属性（lax/strict/none）。
# 推奨: 通常は lax。クロスサイト要件がある場合のみ none（要 Secure=true）。
SESSION_COOKIE_SAMESITE=lax

# SESSION_SECRET_KEY
# Starlette SessionMiddleware の署名鍵（OIDC state/nonce の保護に利用）。
# 本番は十分長いランダム文字列（32文字以上）を使用し、秘匿管理します。
SESSION_SECRET_KEY=replace-with-long-random-secret

# AUTH_DEBUG_RETURN_TOKENS
# true のとき、メール検証/リセットのトークンをAPIレスポンスに含めます。
# 推奨: ローカル検証のみ true。本番/検証環境は必ず false。
AUTH_DEBUG_RETURN_TOKENS=false

# ------------------------------
# Frontend / redirect
# ------------------------------

# FRONTEND_BASE_URL
# 認証完了後のリダイレクト先URLの基底です。
# 注意: 実際に起動しているフロントのURL/ポートと一致させる必要があります。
FRONTEND_BASE_URL=http://localhost:5173

# AUTH_POST_LOGIN_DEFAULT_PATH
# return_to が未指定・不正な場合のデフォルト遷移先パスです。
# 例: /en, /ja。
AUTH_POST_LOGIN_DEFAULT_PATH=/en

# ------------------------------
# Entra ID (OIDC)
# ------------------------------

# ENTRA_TENANT_ID
# Entra テナントID（Directory (tenant) ID）。
ENTRA_TENANT_ID=your-entra-tenant-id

# ENTRA_CLIENT_ID
# Entra アプリケーションID（Application (client) ID）。
ENTRA_CLIENT_ID=your-entra-client-id

# ENTRA_CLIENT_SECRET
# Entra クライアントシークレット。
# 本番では .env 直書きではなく、Secret Manager / Key Vault 等で管理推奨。
ENTRA_CLIENT_SECRET=your-entra-client-secret

# ENTRA_TOKEN_ENCRYPTION_KEY
# Entra の access_token / refresh_token を DB 保存するときに使う暗号化鍵です。
# 任意文字列を指定できますが、十分長いランダム文字列（32文字以上）を推奨します。
# 鍵を変更すると既存の暗号化済みトークンを復号できなくなるため注意してください。
ENTRA_TOKEN_ENCRYPTION_KEY=replace-with-long-random-key

# ENTRA_REDIRECT_URI
# Entra 側に登録したコールバックURLと完全一致させます。
# 例: http://localhost:8000/backend/auth/entra/callback
ENTRA_REDIRECT_URI=http://localhost:8000/backend/auth/entra/callback

# ENTRA_INTERNAL_DOMAINS
# Entraログインを許可するメールドメイン（カンマ区切り・小文字）。
# 例: example.com,subsidiary.example.com
# 未設定（空）はドメイン制限なし。
ENTRA_INTERNAL_DOMAINS=example.com

# ------------------------------
# CSRF / CORS trusted origins
# ------------------------------

# CSRF_TRUSTED_ORIGINS
# 状態変更APIで許可する送信元オリジン（カンマ区切り）。
# フロント実URLと一致が必須です（scheme/host/port）。
# 例: http://localhost:5173,https://app.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ------------------------------
# Gunicorn settings (used by Makefile `make up`)
# ------------------------------

# GUNICORN_WORKERS
# ワーカープロセス数。
# 一般目安: (CPUコア数 × 2) + 1。ただしDB接続上限とメモリを必ず考慮。
# 開発や小規模環境の初期値として 1〜2 が扱いやすいです。
GUNICORN_WORKERS=2

# GUNICORN_THREADS
# 1ワーカーあたりのスレッド数。
# UvicornWorker利用時は通常 1 で十分。特別な要件がなければ 1 推奨。
GUNICORN_THREADS=1

# GUNICORN_TIMEOUT
# ワーカーのリクエストタイムアウト（秒）。
# 一般的な範囲: 30〜120。APIが重い場合は原因分析を優先し、安易な延長は避けます。
GUNICORN_TIMEOUT=60

# GUNICORN_KEEPALIVE
# Keep-Alive 接続維持時間（秒）。
# 一般的な範囲: 2〜15。ロードバランサ設定と揃えると安定しやすいです。
GUNICORN_KEEPALIVE=5
