# ------------------------------
# Backend application settings
# ------------------------------
# FastAPI サービス基本情報
# サービス名（FastAPI タイトル・ログ出力名）
SERVICE_NAME=3pull-api
# API 待受ポート
API_PORT=8000
# アプリログレベル（DEBUG/INFO/WARNING/ERROR）
API_LOG_LEVEL=INFO

# ------------------------------
# Database (required)
# ------------------------------
# SQLAlchemy 非同期 URL（psycopg v3）。例:
# postgresql+psycopg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/threepull
# SQL ログ出力（デバッグ用）
DATABASE_ECHO=false
# プール内の常駐接続数
DATABASE_POOL_SIZE=5
# 常駐接続を超えて一時的に増やせる接続数
DATABASE_MAX_OVERFLOW=10
# 接続取得待ちタイムアウト（秒）
DATABASE_POOL_TIMEOUT=30

# ------------------------------
# Email verification / password reset
# ------------------------------
# メール検証リンクの有効期限（分）
EMAIL_VERIFICATION_TTL_MINUTES=60
# パスワードリセットリンクの有効期限（分）
PASSWORD_RESET_TTL_MINUTES=60

# ------------------------------
# Email login policy
# ------------------------------
# 連続失敗回数が閾値に達したらロック
EMAIL_LOGIN_MAX_FAILURES=5
# ロック時間（分）
EMAIL_LOGIN_LOCK_MINUTES=15

# ------------------------------
# Argon2id password hashing
# ------------------------------
# 計算反復回数（大きいほど総当たり耐性は上がるが認証は遅くなる）
ARGON2_TIME_COST=3
# 使用メモリ量（KiB）。大きいほどGPU/ASIC耐性が上がる
ARGON2_MEMORY_COST=65536
# 並列実行レーン数（CPUコア利用数の目安）
ARGON2_PARALLELISM=4
# 生成するハッシュ長（バイト）
ARGON2_HASH_LEN=32
# ソルト長（バイト）
ARGON2_SALT_LEN=16

# ------------------------------
# App session (DB sessions + HttpOnly Cookie)
# ------------------------------
# 10080分 = 7日
# セッション有効期限（分）。期限超過で再ログインが必要
SESSION_TTL_MINUTES=10080
# ブラウザへ設定するセッションCookie名
SESSION_COOKIE_NAME=app_session
# HTTPS 環境では true、ローカル HTTP では false
# true の場合は HTTPS 通信時のみ Cookie を送信
SESSION_COOKIE_SECURE=true
# CSRF 緩和用の SameSite 属性（lax/strict/none）
SESSION_COOKIE_SAMESITE=lax
# Starlette SessionMiddleware（OIDC state/nonce）用の署名キー
# OIDC 認可フロー用の一時セッション値に署名する秘密鍵
SESSION_SECRET_KEY=replace-with-long-random-secret
# ローカル検証用: true の場合、検証/リセットトークンを API 応答に含める
# 本番は false 固定推奨
AUTH_DEBUG_RETURN_TOKENS=false

# ------------------------------
# Frontend / redirect
# ------------------------------
# フロントエンドURL（ログイン後リダイレクト先の組み立てに利用）
FRONTEND_BASE_URL=http://localhost:5173
# return_to が未指定/不正な場合の遷移先
AUTH_POST_LOGIN_DEFAULT_PATH=/en

# ------------------------------
# Entra ID (OIDC)
# ------------------------------
# Entra テナント ID
ENTRA_TENANT_ID=your-entra-tenant-id
# Entra アプリケーション（クライアント）ID
ENTRA_CLIENT_ID=your-entra-client-id
# Entra クライアントシークレット
ENTRA_CLIENT_SECRET=your-entra-client-secret
# Entra 側に登録した OIDC コールバック URL
ENTRA_REDIRECT_URI=http://localhost:8000/backend/auth/entra/callback
# カンマ区切り・小文字で指定
ENTRA_INTERNAL_DOMAINS=example.com

# ------------------------------
# CSRF / CORS trusted origins
# ------------------------------
# 許可オリジン（カンマ区切り）
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ------------------------------
# Gunicorn settings (used by Makefile `make up`)
# ------------------------------
# Gunicorn 設定（Makefile `make up` で利用）
# ワーカープロセス数
GUNICORN_WORKERS=2
# 1ワーカーあたりのスレッド数
GUNICORN_THREADS=1
# リクエストタイムアウト（秒）
GUNICORN_TIMEOUT=60
# Keep-Alive 秒数
GUNICORN_KEEPALIVE=5
